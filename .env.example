# ============================================================
# NexusHQ — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/nexus_db?schema=public"

# JWT Secrets — generate with: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"
JWT_REFRESH_SECRET="your-refresh-token-secret-different-from-above"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
NODE_ENV="development"

# Railway (auto-set in Railway deployment)
PORT="3000"

# File Uploads (optional — use Railway volumes or S3)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"  # 10MB

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX="100"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,https://your-domain.railway.app"

# Optional: Socket.io
SOCKET_PORT="3001"

# Optional: Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
